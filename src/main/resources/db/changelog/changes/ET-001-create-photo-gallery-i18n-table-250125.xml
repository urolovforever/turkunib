<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="ET-001-create-photo-gallery-i18n-table-250125" author="Ruslan Skaldin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="photo_gallery_i18n"/>
            </not>
        </preConditions>

        <createTable tableName="photo_gallery_i18n">
            <column name="id" type="bigint unsigned" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="photo_gallery_id" type="bigint unsigned">
                <constraints nullable="true"/>
            </column>

            <column name="locale" type="varchar(10)">
                <constraints nullable="false"/>
            </column>

            <column name="title" type="varchar(512)">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="text">
                <constraints nullable="true"/>
            </column>

            <column name="slug" type="varchar(512)">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="timestamp">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <!-- FK на photo_gallery -->
        <addForeignKeyConstraint baseTableName="photo_gallery_i18n"
                                 baseColumnNames="photo_gallery_id"
                                 referencedTableName="photo_gallery"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"
                                 onUpdate="CASCADE"
                                 constraintName="fk_photo_gallery_i18n_photo_gallery"/>

        <addUniqueConstraint tableName="photo_gallery_i18n"
                             columnNames="photo_gallery_id,locale"
                             constraintName="uk_photo_gallery_i18n_gallery_locale"/>

    </changeSet>
</databaseChangeLog>