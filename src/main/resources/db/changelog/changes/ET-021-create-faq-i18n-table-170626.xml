<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="ET-021-create-faq-i18n-table-170626" author="tiu">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="faq_i18n"/>
            </not>
        </preConditions>

        <createTable tableName="faq_i18n">
            <column name="id" type="bigint unsigned" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="faq_id" type="bigint unsigned">
                <constraints nullable="false"/>
            </column>
            <column name="locale" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="question" type="varchar(1024)">
                <constraints nullable="true"/>
            </column>
            <column name="answer" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="faq_i18n"
                                 baseColumnNames="faq_id"
                                 referencedTableName="faqs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"
                                 onUpdate="CASCADE"
                                 constraintName="fk_faq_i18n_faq"/>

        <addUniqueConstraint tableName="faq_i18n"
                             columnNames="faq_id,locale"
                             constraintName="uk_faq_i18n_faq_locale"/>

        <createIndex tableName="faq_i18n" indexName="idx_faq_i18n_locale">
            <column name="locale"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
