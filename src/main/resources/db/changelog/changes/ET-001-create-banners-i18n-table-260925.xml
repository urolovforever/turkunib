<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="ET-001-create-banners-i18n-table-260925" author="Ruslan Skaldin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="banners_i18n"/>
            </not>
        </preConditions>

        <createTable tableName="banners_i18n">
            <column name="id" type="bigint unsigned" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="banner_id" type="bigint unsigned">
                <constraints nullable="false"/>
            </column>

            <column name="locale" type="varchar(10)">
                <constraints nullable="false"/>
            </column>

            <column name="title" type="varchar(512)">
                <constraints nullable="false"/>
            </column>

            <column name="url_title" type="varchar(256)">
                <constraints nullable="true"/>
            </column>

            <column name="short_title" value="" type="varchar(256)">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="text">
                <constraints nullable="true"/>
            </column>

            <column name="url" type="varchar(1024)">
                <constraints nullable="true"/>
            </column>

            <column name="updated_at" type="timestamp">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="banners_i18n"
                                 baseColumnNames="banner_id"
                                 referencedTableName="banners"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"
                                 onUpdate="CASCADE"
                                 constraintName="fk_banners_i18n_banners_id"/>

        <addUniqueConstraint tableName="banners_i18n"
                             columnNames="banner_id,locale"
                             constraintName="uk_banners_i18n_banner_locale"/>

    </changeSet>
</databaseChangeLog>