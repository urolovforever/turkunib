    <changeSet id="ET-001-create-ft-news-i18n-title-content-index-070925" author="Ruslan Skaldin">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="ft_news_i18n_title_content_description" tableName="news"/>
