<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="ET-001-create-translation-task-table-290925" author="Ruslan Skaldin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="translation_tasks"/>
            </not>
        </preConditions>

        <!-- Create a translation_tasks table -->
        <createTable tableName="translation_tasks">
            <column name="id" type="bigint unsigned" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="module_name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="entity_id" type="bigint unsigned">
                <constraints nullable="false"/>
            </column>

            <column name="source_hash" type="varchar(512)">
                <constraints nullable="false"/>
            </column>

            <column name="source_locale" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="target_locale" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="varchar(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>

            <column name="attempt" type="int unsigned" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="error_message" type="text">
                <constraints nullable="true"/>
            </column>

            <column name="started_at" type="timestamp">
                <constraints nullable="true"/>
            </column>

            <column name="updated_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <!-- Add unique constraint to prevent duplicate translation tasks -->
        <addUniqueConstraint columnNames="module_name, entity_id, source_hash, target_locale"
                constraintName="uk_translation_task_unique"
                tableName="translation_tasks"/>

    </changeSet>
</databaseChangeLog>