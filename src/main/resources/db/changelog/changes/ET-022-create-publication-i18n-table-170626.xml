<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="ET-022-create-publication-i18n-table-170626" author="tiu">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="publication_i18n"/>
            </not>
        </preConditions>

        <createTable tableName="publication_i18n">
            <column name="id" type="bigint unsigned" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="publication_id" type="bigint unsigned">
                <constraints nullable="false"/>
            </column>
            <column name="locale" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(512)">
                <constraints nullable="true"/>
            </column>
            <column name="description" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="publication_i18n"
                                 baseColumnNames="publication_id"
                                 referencedTableName="publications"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"
                                 onUpdate="CASCADE"
                                 constraintName="fk_publication_i18n_publication"/>

        <addUniqueConstraint tableName="publication_i18n"
                             columnNames="publication_id,locale"
                             constraintName="uk_publication_i18n_publication_locale"/>

        <createIndex tableName="publication_i18n" indexName="idx_publication_i18n_locale">
            <column name="locale"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
