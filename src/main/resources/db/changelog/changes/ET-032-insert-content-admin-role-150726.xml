<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="ET-032-insert-content-admin-role-150726" author="tiu">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM roles WHERE name = 'ROLE_CONTENT_ADMIN'
            </sqlCheck>
        </preConditions>

        <insert tableName="roles">
            <column name="name" value="ROLE_CONTENT_ADMIN"/>
            <column name="full_name" value="Content Administrator (no access to applications)"/>
        </insert>
    </changeSet>

</databaseChangeLog>
